<div class="flex-wrap space-y-4 md:flex md:flex-nowrap md:space-y-0 md:space-x-10">
  <%= render 'shared/settings_nav' %>
  <div class="md:flex-grow">
    <div class="flex flex-col md:flex-row md:flex-wrap gap-2 md:justify-between md:items-end mb-4 min-h-12">
      <div>
        <div class="text-sm breadcrumbs mb-1">
          <ul>
            <li><%= link_to t('teams'), settings_teams_path %></li>
            <li><%= @team.name %></li>
          </ul>
        </div>
        <h1 class="text-4xl font-bold flex items-center gap-3">
          <%= @team.name %>
          <%= link_to edit_settings_team_path(@team), class: 'btn btn-ghost btn-sm', data: { turbo_frame: 'modal' } do %>
            <%= svg_icon('pencil', class: 'w-5 h-5') %>
          <% end %>
        </h1>
      </div>
    </div>

    <!-- Add Member Form -->
    <% if @available_users.any? %>
      <div class="mb-6 p-4 bg-base-200 rounded-lg">
        <h2 class="text-lg font-semibold mb-3"><%= t('add_member') %></h2>
        <%= form_tag settings_team_memberships_path(@team), method: :post, class: 'flex flex-wrap gap-2 items-end' do %>
          <div class="form-control flex-grow">
            <select name="user_id" class="select select-bordered w-full" required aria-label="<%= t('select_user') %>">
              <option value="" disabled selected><%= t('choose_a_user') %></option>
              <% @available_users.each do |user| %>
                <option value="<%= user.id %>"><%= user.full_name.presence || user.email %> (<%= user.email %>)</option>
              <% end %>
            </select>
          </div>
          <button type="submit" class="btn btn-primary min-h-[44px]"><%= t('add') %></button>
        <% end %>
      </div>
    <% end %>

    <!-- Members List -->
    <h2 class="text-2xl font-bold mb-3"><%= t('members') %> (<%= @members.size %>)</h2>
    <% if @members.any? %>
      <div class="overflow-x-auto">
        <table class="table w-full table-lg rounded-b-none overflow-hidden">
          <thead class="bg-base-200">
            <tr class="text-neutral uppercase">
              <th><%= t('name') %></th>
              <th><%= t('email') %></th>
              <th><%= t('role') %></th>
              <th class="text-right" width="1px"></th>
            </tr>
          </thead>
          <tbody>
            <% @members.each do |user| %>
              <tr scope="row">
                <td><%= user.full_name %></td>
                <td><%= user.email %></td>
                <td>
                  <span class="badge badge-info badge-outline whitespace-nowrap"><%= t(user.role) %></span>
                </td>
                <td class="text-right">
                  <%= button_to settings_team_membership_path(@team, user.id), method: :delete, class: 'btn btn-outline btn-error btn-xs', data: { turbo_confirm: t('are_you_sure_') } do %>
                    <%= t('remove') %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-base-content/70"><%= t('no_members_in_team') %></p>
    <% end %>
  </div>
</div>
