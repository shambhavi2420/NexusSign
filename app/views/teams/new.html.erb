<%= render 'shared/turbo_modal', title: t('new_team') do %>
  <%= form_for @team, url: settings_teams_path, data: { turbo_frame: :_top }, html: { autocomplete: :off } do |f| %>
    <div class="form-control my-6">
      <%= f.text_field :name, required: true, placeholder: "#{t('team_name')}...", class: 'base-input w-full', autofocus: true, dir: 'auto' %>
    </div>
    <% if @team.errors.any? %>
      <div class="text-error text-sm mb-4">
        <% @team.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>
    <div class="form-control">
      <%= f.button button_title(title: t('create'), disabled_with: t('creating')), class: 'base-button' %>
    </div>
  <% end %>
<% end %>
