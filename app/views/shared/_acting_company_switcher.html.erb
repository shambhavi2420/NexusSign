<% if signed_in? && current_user.super_admin? %>
  <% companies = Account.active.order(:name) %>
  <% current_company = acting_company || current_user.account %>
  <div class="w-full <%= acting_as_other_company? ? 'bg-warning/20' : 'bg-base-200' %>">
    <div class="max-w-6xl mx-auto px-4 md:px-2 py-1.5 flex items-center justify-between gap-2 text-sm">
      <div class="flex items-center gap-2 min-w-0">
        <span class="font-medium whitespace-nowrap"><%= t('acting_as') %>:</span>
        <div class="dropdown">
          <label tabindex="0" class="btn btn-xs btn-outline max-w-[220px] truncate">
            <span class="truncate"><%= current_company&.name %></span>
            <%= svg_icon('arrow_sort', class: 'w-3 h-3 ml-1') %>
          </label>
          <ul tabindex="0" class="dropdown-content z-[20] menu p-2 shadow bg-base-100 rounded-box mt-1 max-h-80 overflow-y-auto min-w-56">
            <% companies.each do |company| %>
              <li>
                <%= button_to acting_company_path, params: { account_id: company.id }, method: :post,
                              class: "text-sm #{'font-semibold' if company.id == current_company&.id}" do %>
                  <%= company.name %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
      <% if acting_as_other_company? %>
        <%= button_to t('exit'), acting_company_path, method: :delete, class: 'btn btn-xs btn-ghost' %>
      <% end %>
    </div>
  </div>
<% end %>
