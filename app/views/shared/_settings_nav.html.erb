<div class="block w-full md:w-52 flex-none">
  <menu-active>
    <ul id="account_settings_menu" class="menu px-0">
      <li class="menu-title py-0 !bg-transparent mb-3 -mt-5"><a href="<%= '/' %>" class="!bg-transparent !text-neutral font-medium flex items-center space-x-0.5"><%= svg_icon('arrow_left', class: 'w-4 h-4 stroke-2') %><span><%= t('back') %></span></a></li>
      <li class="menu-title py-0 !bg-transparent">
        <span class="!bg-transparent"><%= t('settings') %></span>
      </li>
      <li></li>
      <li>
        <%= link_to t('profile'), settings_profile_index_path, class: 'text-base hover:bg-base-300' %>
      </li>
      <% if current_user.super_admin? || current_user.can_access_setting?('account') %>
        <li>
          <%= link_to t('account'), settings_account_path, class: 'text-base hover:bg-base-300' %>
        </li>
      <% end %>
      <% unless Docuseal.multitenant? %>
        <% if (current_user.super_admin? || current_user.can_access_setting?('email')) && ENV['SMTP_ADDRESS'].blank? && true_user == current_user %>
          <li>
            <%= link_to t('email'), settings_email_index_path, class: 'text-base hover:bg-base-300' %>
          </li>
        <% end %>
        <% if (current_user.super_admin? || current_user.can_access_setting?('storage')) && true_user == current_user %>
          <li>
            <%= link_to t('storage'), settings_storage_index_path, class: 'text-base hover:bg-base-300' %>
          </li>
        <% end %>

      <% end %>
      <% if current_user.super_admin? || current_user.can_access_setting?('notifications') %>
        <li>
          <%= link_to t('notifications'), settings_notifications_path, class: 'text-base hover:bg-base-300' %>
        </li>
      <% end %>

      <% if current_user.super_admin? || current_user.can_access_setting?('personalization') %>
        <li>
          <%= link_to t('personalization'), settings_personalization_path, class: 'text-base hover:bg-base-300' %>
        </li>
      <% end %>
      <% if current_user.super_admin? || current_user.can_access_setting?('users') %>
        <li>
          <%= link_to t('users'), settings_users_path, class: 'text-base hover:bg-base-300' %>
        </li>
      <% end %>
      <% if current_user.super_admin? ||
            current_user.can_access_setting?('folder_permissions') ||
            current_account.template_folders.active.exists?(author_id: current_user.id) %>
        <li>
          <%= link_to t('folder_permissions'), settings_folder_permissions_path, class: 'text-base hover:bg-base-300' %>
        </li>
      <% end %>
      <% if current_user.super_admin? || current_user.can_access_setting?('teams') %>
        <li>
          <%= link_to t('teams'), settings_teams_path, class: 'text-base hover:bg-base-300' %>
        </li>
      <% end %>
      <% if current_user.super_admin? || current_user.can_access_setting?('data_migration') %>
        <li>
          <%= link_to t('data_migration'), data_migration_path, class: 'text-base hover:bg-base-300' %>
        </li>
      <% end %>
      <% if current_user.super_admin? || current_user.can_access_setting?('webhooks') %>
        <li>
          <%= link_to t('webhook_settings'), settings_webhooks_path, class: 'text-base hover:bg-base-300' %>
        </li>
      <% end %>
      <%= render 'shared/settings_nav_extra' %>
      <% if Docuseal.demo? || !Docuseal.multitenant? %>
        <% if current_user.super_admin? || current_user.can_access_setting?('api') %>
          <li>
            <%= link_to 'API', settings_api_index_path, class: 'text-base hover:bg-base-300' %>
          </li>
        <% end %>
      <% end %>
      <% if !Docuseal.multitenant? && defined?(Sidekiq::Web) &&
            (current_user.super_admin? || current_user.can_access_setting?('jobs')) %>
        <li>
          <%= link_to t('background_jobs'), '/jobs', class: 'text-base hover:bg-base-300' %>
        </li>
      <% end %>
    </ul>
  </menu-active>
</div>
